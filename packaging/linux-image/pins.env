# Pinned inputs of the Slate Operations Linux image (docs/plans/windows-installer.md W4).
# build.sh and build-rootfs.sh source this file; scripts/release_linux_image.py reads it
# (KEY="value" lines only). Change a pin here and nowhere else.

# The build container: Debian 13 slim, by index digest (checked 2026-11-16).
BUILD_IMAGE="debian:trixie-20261104-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2"

# W4-1: every Debian package comes from snapshot.debian.org at this time (main, updates,
# security). The image's file times are clamped to it (SOURCE_DATE_EPOCH).
SNAPSHOT="20261115T210008Z"

# The Debian 13 keys that may sign the snapshot (debian-archive-keyring 2025.1 in the
# build container): archive, security archive, stable release.
DEBIAN_KEY_ARCHIVE="04B54C3CDCA79751B16BC6B5225629DF75B188BD"
DEBIAN_KEY_SECURITY="5E04A1E3223A19A20706E20F9904613D4CCE68C6"
DEBIAN_KEY_RELEASE="41587F7DB8C774BCCF131416762F67A0B2C39DE4"

# W4-2: Docker's apt signing key (primary key fingerprint, docs.docker.com and the key).
DOCKER_KEY_URL="https://download.docker.com/linux/debian/gpg"
DOCKER_KEY_FINGERPRINT="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"
DOCKER_REPOSITORY="https://download.docker.com/linux/debian"

# Exact Docker package versions. Docker 29.8 is the line that proved `docker load` of the
# release's OCI archives with the containerd image store (TASK-0079 N-1).
DOCKER_CE_VERSION="5:29.8.2-1~debian.13~trixie"
DOCKER_CE_CLI_VERSION="5:29.8.2-1~debian.13~trixie"
CONTAINERD_IO_VERSION="2.3.6-1~debian.13~trixie"
DOCKER_COMPOSE_PLUGIN_VERSION="5.7.1-1~debian.13~trixie"

# W4-3: cosign, the same release as .github/workflows/release.yml. The SHA-256 values are
# in the release's cosign_checksums.txt (checked 2026-11-16).
COSIGN_VERSION="3.1.4"
COSIGN_SHA256_AMD64="424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa"
COSIGN_SHA256_ARM64="ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2"
# The LICENSE file of the cosign source at tag v3.1.4 (Apache-2.0).
COSIGN_LICENSE_SHA256="c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4"
