# Slate Operations provider installation file (Compose --env-file). Template.
# The engine renders it with packaging/engine/env_templates.py into /etc/slateops/ (0600).
# {{NAME}} takes a literal value: printable ASCII without $ # ' ` \ or a leading quote.
# {{NAME|compose}} takes customer text in Compose double quotes (\ " $ escaped; CR, LF, NUL
# refused). Only this file may hold quoted values: no docker run reads it.
# Comments stay on their own lines; Compose cuts an inline " #".

# Instance and images.
SLATEOPS_INSTANCE_ID={{SLATEOPS_INSTANCE_ID}}
SLATEOPS_SERVER_IMAGE={{SLATEOPS_SERVER_IMAGE}}
SLATEOPS_CADDY_IMAGE={{SLATEOPS_CADDY_IMAGE}}

# Public addresses.
API_EXTERNAL_URL=https://{{PUBLIC_HOST}}/auth/v1
SITE_URL=https://{{PUBLIC_HOST}}
# Operator gateway URL (Storage's public URL). Customer installs publish no port for it
# (compose.installer.yaml); the development stack publishes it on loopback.
SUPABASE_PUBLIC_URL=http://127.0.0.1:58000
AUTH_TEMPLATE_BASE_URL=http://api:8000/api/auth/email-templates

# Generated secrets (supabase_keys.py --format docker).
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
JWT_SECRET={{JWT_SECRET}}
JWT_KEYS={{JWT_KEYS}}
JWT_JWKS={{JWT_JWKS}}
ANON_KEY={{ANON_KEY}}
SERVICE_ROLE_KEY={{SERVICE_ROLE_KEY}}
ANON_KEY_ASYMMETRIC={{ANON_KEY_ASYMMETRIC}}
SERVICE_ROLE_KEY_ASYMMETRIC={{SERVICE_ROLE_KEY_ASYMMETRIC}}
SUPABASE_PUBLISHABLE_KEY={{SUPABASE_PUBLISHABLE_KEY}}
SUPABASE_SECRET_KEY={{SUPABASE_SECRET_KEY}}
REALTIME_SECRET_KEY_BASE={{REALTIME_SECRET_KEY_BASE}}
REALTIME_DB_ENC_KEY={{REALTIME_DB_ENC_KEY}}
# Read only by studio and meta. Compose interpolates the whole file, so they stay required
# while customer installs do not start studio, meta and imgproxy (W5b decides).
PG_META_CRYPTO_KEY={{PG_META_CRYPTO_KEY}}
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD={{DASHBOARD_PASSWORD}}

# Customer email account (from the staged smtp.env).
SMTP_HOST={{SMTP_HOST}}
SMTP_PORT={{SMTP_PORT}}
SMTP_ADMIN_EMAIL={{SMTP_ADMIN_EMAIL|compose}}
SMTP_USER={{SMTP_USER|compose}}
SMTP_PASS={{SMTP_PASS|compose}}
SMTP_SENDER_NAME={{SMTP_SENDER_NAME|compose}}

# Application overlay. The two *_ROOT lines are read literally by the backup runner:
# one unquoted line each, absolute paths.
SLATEOPS_APP_ENV_FILE=/etc/slateops/app.env
SLATEOPS_LOG_ROOT=/var/log/slateops/app
SLATEOPS_BACKUP_EXPORT_ROOT={{SLATEOPS_BACKUP_EXPORT_ROOT}}
SLATEOPS_APP_PRIVATE_SUBNET={{SLATEOPS_APP_PRIVATE_SUBNET}}
API_WORKERS=1
CADDY_CONFIG_PATH=/etc/slateops/Caddyfile
CADDY_TLS_DIR=/etc/slateops/tls
CADDY_PUBLIC_BIND_HOST=0.0.0.0
CADDY_HTTPS_PORT=443
