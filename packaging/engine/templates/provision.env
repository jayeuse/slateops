# Slate Operations provisioning job environment (docker run --env-file). Template.
# Literal KEY=value lines only. Never give this file to the long-running API.
ENVIRONMENT=production
SLATEOPS_INSTANCE_ID={{SLATEOPS_INSTANCE_ID}}
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
DATABASE_BOOTSTRAP_URL=postgresql+psycopg://supabase_admin:{{POSTGRES_PASSWORD}}@db:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://slateops_owner:{{SLATEOPS_OWNER_DB_PASSWORD}}@db:5432/postgres
DATABASE_URL=postgresql+psycopg://slateops_runtime:{{SLATEOPS_RUNTIME_DB_PASSWORD}}@db:5432/postgres
SUPABASE_URL=http://api-gw:8000
SUPABASE_AUTH_ISSUER=https://{{PUBLIC_HOST}}/auth/v1
SUPABASE_SECRET_KEY={{SUPABASE_SECRET_KEY}}
