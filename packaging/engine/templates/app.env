# Slate Operations API environment (Compose env_file and docker run --env-file). Template.
# Literal KEY=value lines only: no quotes, no customer text, comments on their own lines.
# The server image sets SLATEOPS_VERSION, SLATEOPS_ENV_SOURCE and WEB_ASSETS_ROOT; an env
# file value would override them, so this file never names them.
# These values equal compose.production.yaml, because the backup bridge loads this file alone.
ENVIRONMENT=production
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT=8000
SUPABASE_URL=http://api-gw:8000
SUPABASE_AUTH_ISSUER=https://{{PUBLIC_HOST}}/auth/v1
LOG_DIR=/var/log/slateops/api

SLATEOPS_INSTANCE_ID={{SLATEOPS_INSTANCE_ID}}
PUBLIC_ORIGIN=https://{{PUBLIC_HOST}}
DATABASE_URL=postgresql+psycopg://slateops_runtime:{{SLATEOPS_RUNTIME_DB_PASSWORD}}@db:5432/postgres

# Generated secrets (supabase_keys.py --format docker).
SUPABASE_PUBLISHABLE_KEY={{SUPABASE_PUBLISHABLE_KEY}}
SUPABASE_SECRET_KEY={{SUPABASE_SECRET_KEY}}
SUPABASE_SESSION_ENCRYPTION_KEY={{SUPABASE_SESSION_ENCRYPTION_KEY}}
PUBLICATION_SIGNING_KEY={{PUBLICATION_SIGNING_KEY}}
REALTIME_TOKEN_SIGNING_KEY={{REALTIME_TOKEN_SIGNING_KEY}}
SECURITY_EVENT_SERVER_KEY={{SECURITY_EVENT_SERVER_KEY}}

# Fixed API limits (the .env.example defaults).
LIFECYCLE_PURGE_ENABLED=true
AUTH_REFRESH_TOKEN_DAYS=7
SUPABASE_TIMEOUT_SECONDS=10
REQUEST_BODY_MAX_BYTES=1048576
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=15000
READINESS_POOL_TIMEOUT_SECONDS=0.25
READINESS_CONNECT_TIMEOUT_SECONDS=1
READINESS_STATEMENT_TIMEOUT_MS=500
READINESS_CALLER_TIMEOUT_SECONDS=2
SERVER_MAX_CONCURRENCY=64
SERVER_KEEP_ALIVE_SECONDS=5
