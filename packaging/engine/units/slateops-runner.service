# Slate Operations: one engine tick (TASK-0093). The engine runs the unchanged backup runner
# in a one-shot server-image container, then the daily certificate renewal when it is due.
# systemd starts no second instance while one runs. The engine makes the run ID itself.
[Unit]
Description=Slate Operations backup runner tick
# Wants, not Requires: a Docker Engine upgrade in the package night (plan 7.4) restarts
# docker.service, and Requires= would restart this tick with apt and dpkg inside it.
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/slateops-engine --timer tick
